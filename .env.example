# Copy to .env and fill in what you have. Everything is optional for a local
# terminal run except ANTHROPIC_API_KEY.

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEYS=
# CLAUDE_MODEL=claude-opus-5-5

# Photon Spectrum Cloud (app.photon.codes → your project → Settings).
# Leave both empty to run in the terminal chat instead of iMessage.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# PLATFORM=auto            # auto | imessage | terminal

# Postgres with pgvector, e.g. Supabase (Project Settings → Database → connection string).
# Empty → embedded PGlite in data/pglite (no setup).
DATABASE_URL=

# Capital One Nessie sandbox key. Empty → mock bank using members.json startBalance.
NESSIE_API_KEY=
# NESSIE_BASE_URL=http://api.nessieisreal.com

# Voice: mock (simulated front desk) or retell
VOICE_PROVIDER=mock
# MOCK_CALL_OUTCOME=booked   # booked | needs_input | failed
RETELL_API_KEY=
RETELL_FROM_NUMBER=          # E.164 number imported into Retell (the Photon number via SIP)
RETELL_AGENT_ID=
# Every demo hotel is dialed at this number (a teammate's phone). Only allowlisted numbers are ever called.
DEMO_FRONT_DESK_PHONE=
# CALL_ALLOWLIST=+16175550199,+16175550198

# AGENT_NAME=Tripchat
# TRIP_TIMEZONE=America/New_York
# BALANCE_CAP_FRACTION=0.5
# DEBUG_PORT=8787            # 0 disables the local retrieval debug page
