# Copy to .env and fill in what you have. Everything is optional for a local
# terminal run except ANTHROPIC_API_KEY.

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Photon 2.0 beta (app.beta.photon.codes → your project → API keys). See docs/photon-setup.md.
# Leave both empty to run in the terminal chat instead of iMessage.
PHOTON_PROJECT_ID=           # pho_prj_...
PHOTON_API_KEY=              # pho_sk_...
# PHOTON_AGENT_USER_ID=      # pho_usr_... reply as this agent; default: the project agent in each chat
# PHOTON_POLL_MS=2000
# Send replies for one Space to another, when Photon files a group's incoming
# messages under a Space it can't send to (docs/photon-setup.md):
# PHOTON_REPLY_SPACES=pho_spc_IN:pho_spc_OUT
# Signup page that starts group chats (iMessage mode). 0 disables. Listens on
# this machine only unless SIGNUP_HOST is changed; anyone who can reach it can
# make the line text any number.
# SIGNUP_PORT=8788
# SIGNUP_HOST=127.0.0.1
# PLATFORM=auto            # auto | imessage | terminal

# Ensemble (code name Orbit; settings keep the ORBIT_ prefix): build apps from the group chat.
# Daytona (app.daytona.io → Keys). Set it and apps are served from public Daytona sandboxes; empty → this machine serves them (testing only).
DAYTONA_API_KEY=
# ORBIT_HOST=auto              # auto | daytona | local
# ORBIT_BUILDER=auto           # claude-code (Claude Code runs headless in the Daytona sandbox; default with a Daytona key) | api (Claude API writes the file; default without)
# ORBIT_BUILD_EFFORT=low       # low ≈ 45 s per build, medium ≈ 2.5 min
# ORBIT_SPEC=true              # write a detailed design spec from the whole chat before building v1
# ORBIT_SPEC_EFFORT=medium
# ORBIT_SPEC_MODEL=claude-sonnet-5-5
# Only these numbers can start builds. Empty → everyone in members.json and the signup groups.
ORBIT_ALLOWED=
# ORBIT_CONFIRM_EDITS=false    # true: edits (v2, v3…) also wait for "ship it"
# ORBIT_BUILD_TIMEOUT_S=420
# Repo mode: paste a GitHub link in the chat. A fine-grained token (github.com/settings/personal-access-tokens)
# with Contents + Pull requests: read and write, on the repos you'll use. Without it: public repos only, nothing pushed.
GITHUB_TOKEN=
# ORBIT_REPO_TIMEOUT_S=900
# ENSEMBLE_REPO=https://github.com/Wilozz/HackHarvard2026   # what "this repository" / "your own code" means
# ORBIT_PUBLIC_URL=            # local host only: e.g. http://10.0.0.5:8788 so phones on the same Wi-Fi can open links
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome   # post-build check; empty skips it
# AGENT_NAME=Ensemble   # what people type after @ in the chat

# Postgres with pgvector for chat memory. Supabase: Connect → "Session pooler" string
# (postgresql://postgres.<ref>:<password>@aws-…pooler.supabase.com:5432/postgres; the
# Direct connection is IPv6-only). Then: npm run db:setup && npm run db:selftest
# Empty → embedded PGlite in data/pglite (no setup).
DATABASE_URL=

# Capital One Nessie sandbox key. Empty → mock bank using members.json startBalance.
NESSIE_API_KEY=
# NESSIE_BASE_URL=https://api.nessieisreal.com   # plain http:// is blocked
# NESSIE_START_BALANCE=1500   # opening balance for people added from the signup page
# MAX_TRANSFER_USD=1000       # no single transfer may exceed this

# Voice: mock (simulated front desk) or retell
VOICE_PROVIDER=mock
# MOCK_CALL_OUTCOME=booked   # booked | needs_input | failed
RETELL_API_KEY=
RETELL_FROM_NUMBER=          # E.164 number imported into Retell (the Photon number via SIP)
RETELL_AGENT_ID=
# Every demo hotel is dialed at this number (a teammate's phone). Only allowlisted numbers are ever called.
DEMO_FRONT_DESK_PHONE=
# CALL_ALLOWLIST=+16175550199,+16175550198

# AGENT_NAME=Tripchat
# TRIP_TIMEZONE=America/New_York
# BALANCE_CAP_FRACTION=0.5
# DEBUG_PORT=8787            # 0 disables the local retrieval debug page
