# Copy to .env and fill in what you have. Everything is optional for a local
# terminal run except ANTHROPIC_API_KEY.

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Photon 2.0 beta (app.beta.photon.codes → your project → API keys). See docs/photon-setup.md.
# Leave both empty to run in the terminal chat instead of iMessage.
PHOTON_PROJECT_ID=           # pho_prj_...
PHOTON_API_KEY=              # pho_sk_...
# PHOTON_AGENT_USER_ID=      # pho_usr_... reply as this agent; default: the project agent in each chat
# PHOTON_POLL_MS=2000
# Send replies for one Space to another, when Photon files a group's incoming
# messages under a Space it can't send to (docs/photon-setup.md):
# PHOTON_REPLY_SPACES=pho_spc_IN:pho_spc_OUT
# Signup page that starts group chats (iMessage mode). 0 disables. Listens on
# this machine only unless SIGNUP_HOST is changed; anyone who can reach it can
# make the line text any number.
# SIGNUP_PORT=8788
# SIGNUP_HOST=127.0.0.1
# PLATFORM=auto            # auto | imessage | terminal

# Postgres with pgvector for chat memory. Supabase: Connect → "Session pooler" string
# (postgresql://postgres.<ref>:<password>@aws-…pooler.supabase.com:5432/postgres; the
# Direct connection is IPv6-only). Then: npm run db:setup && npm run db:selftest
# Empty → embedded PGlite in data/pglite (no setup).
DATABASE_URL=

# Capital One Nessie sandbox key. Empty → mock bank using members.json startBalance.
NESSIE_API_KEY=
# NESSIE_BASE_URL=http://api.nessieisreal.com

# Voice: mock (simulated front desk) or retell
VOICE_PROVIDER=mock
# MOCK_CALL_OUTCOME=booked   # booked | needs_input | failed
RETELL_API_KEY=
RETELL_FROM_NUMBER=          # E.164 number imported into Retell (the Photon number via SIP)
RETELL_AGENT_ID=
# Every demo hotel is dialed at this number (a teammate's phone). Only allowlisted numbers are ever called.
DEMO_FRONT_DESK_PHONE=
# CALL_ALLOWLIST=+16175550199,+16175550198

# AGENT_NAME=Tripchat
# TRIP_TIMEZONE=America/New_York
# BALANCE_CAP_FRACTION=0.5
# DEBUG_PORT=8787            # 0 disables the local retrieval debug page
