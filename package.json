{
  "name": "tripchat",
  "version": "0.1.0",
  "private": true,
  "description": "AI travel agent that lives in your iMessage group chat (HackHarvard 2026)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed:chat": "tsx scripts/seed-chat.ts",
    "seed:nessie": "tsx scripts/seed-nessie.ts",
    "reset": "tsx scripts/reset.ts",
    "db:setup": "tsx scripts/db.ts setup",
    "db:check": "tsx scripts/db.ts check",
    "db:selftest": "tsx scripts/db.ts selftest",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@huggingface/transformers": "^4.3.1",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1",
    "spectrum-ts": "^12.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
